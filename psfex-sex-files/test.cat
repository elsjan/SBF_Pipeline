#   1 NUMBER                 Running object number                                     
#   2 X_IMAGE                Object position along x                                    [pixel]
#   3 Y_IMAGE                Object position along y                                    [pixel]
#   4 ID_PARENT              Parent ID (before deblending)                             
#   5 EXT_NUMBER             FITS extension number                                     
#   6 FLUX_ISO               Isophotal flux                                             [count]
#   7 FLUXERR_ISO            RMS error for isophotal flux                               [count]
#   8 MAG_ISO                Isophotal magnitude                                        [mag]
#   9 MAGERR_ISO             RMS error for isophotal magnitude                          [mag]
#  10 FLUX_ISOCOR            Corrected isophotal flux                                   [count]
#  11 FLUXERR_ISOCOR         RMS error for corrected isophotal flux                     [count]
#  12 MAG_ISOCOR             Corrected isophotal magnitude                              [mag]
#  13 MAGERR_ISOCOR          RMS error for corrected isophotal magnitude                [mag]
#  14 FLUX_APER              Flux vector within fixed circular aperture(s)              [count]
#  15 FLUXERR_APER           RMS error vector for aperture flux(es)                     [count]
#  16 MAG_APER               Fixed aperture magnitude vector                            [mag]
#  17 MAGERR_APER            RMS error vector for fixed aperture mag.                   [mag]
#  18 FLUX_AUTO              Flux within a Kron-like elliptical aperture                [count]
#  19 FLUXERR_AUTO           RMS error for AUTO flux                                    [count]
#  20 MAG_AUTO               Kron-like elliptical aperture magnitude                    [mag]
#  21 MAGERR_AUTO            RMS error for AUTO magnitude                               [mag]
#  22 KRON_RADIUS            Kron apertures in units of A or B                         
#  23 FLUX_PETRO             Flux within a Petrosian-like elliptical aperture           [count]
#  24 FLUXERR_PETRO          RMS error for PETROsian flux                               [count]
#  25 MAG_PETRO              Petrosian-like elliptical aperture magnitude               [mag]
#  26 MAGERR_PETRO           RMS error for PETROsian magnitude                          [mag]
#  27 PETRO_RADIUS           Petrosian apertures in units of A or B                    
#  28 FLUX_GROWTH            Cumulated growth-curve                                     [count]
#  29 FLUX_GROWTHSTEP        Step for growth-curves                                     [pixel]
#  30 MAG_GROWTH             Cumulated magnitude growth-curve                           [mag]
#  31 MAG_GROWTHSTEP         Step for growth-curves                                     [pixel]
#  32 FLUX_RADIUS            Fraction-of-light radii                                    [pixel]
#  33 BACKGROUND             Background at centroid position                            [count]
#  34 MU_MAX                 Peak surface brightness above background                   [mag * arcsec**(-2)]
#  35 X_FOCAL                Barycenter position along focal-plane x axis              
#  36 Y_FOCAL                Barycenter position along focal-plane y axis              
#  37 X_WORLD                Barycenter position along world x axis                     [deg]
#  38 Y_WORLD                Barycenter position along world y axis                     [deg]
#  39 ALPHA_SKY              Right ascension of barycenter (native)                     [deg]
#  40 DELTA_SKY              Declination of barycenter (native)                         [deg]
#  41 ALPHA_J2000            Right ascension of barycenter (J2000)                      [deg]
#  42 DELTA_J2000            Declination of barycenter (J2000)                          [deg]
#  43 THETA_IMAGE            Position angle (CCW/x)                                     [deg]
#  44 ELONGATION             A_IMAGE/B_IMAGE                                           
#  45 ELLIPTICITY            1 - B_IMAGE/A_IMAGE                                       
#  46 CLASS_STAR             S/G classifier output                                     
